{
  "name": "mui-hermes-chat",
  "version": "0.5.0",
  "description": "Embeddable Hermes chat for React + MUI (on @mui/x-chat)",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ejlevin1/mui-hermes-chat.git" },
  "homepage": "https://github.com/ejlevin1/mui-hermes-chat#readme",
  "bugs": { "url": "https://github.com/ejlevin1/mui-hermes-chat/issues" },
  "keywords": ["react", "mui", "chat", "hermes", "x-chat", "sse"],
  "publishConfig": { "access": "public", "provenance": true },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=20.19" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "hooks": "git config core.hooksPath .githooks"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-chat": "9.0.0-alpha.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-chat": "9.0.0-alpha.22",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
