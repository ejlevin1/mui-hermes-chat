#!/usr/bin/env bash
# Scan exactly the commits being pushed. Fails closed.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not found on PATH. Install it: brew install gitleaks" >&2
  echo "(explicit bypass, not recommended: git push --no-verify)" >&2
  exit 1
fi
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue # deletion
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  if ! gitleaks git --redact --no-banner --config .gitleaks.toml --log-opts="$range"; then
    echo "pre-push: gitleaks found a leak in $local_ref ($range). Push blocked." >&2
    status=1
  fi
done
if [ "$status" -ne 0 ]; then
  echo "(explicit bypass, not recommended: git push --no-verify)" >&2
fi
exit "$status"
