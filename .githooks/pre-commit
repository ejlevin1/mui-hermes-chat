#!/usr/bin/env bash
# Scan staged changes for secrets and system-specific data. Fails closed.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found on PATH. Install it: brew install gitleaks" >&2
  echo "(explicit bypass, not recommended: git commit --no-verify)" >&2
  exit 1
fi
if ! gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml; then
  echo "pre-commit: gitleaks found a leak in the staged changes (see above). Remove it and retry." >&2
  echo "(explicit bypass, not recommended: git commit --no-verify)" >&2
  exit 1
fi
